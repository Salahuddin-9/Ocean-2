{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user and portfolio builder profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "name": { "type": "string", "description": "User's display name" },
        "email": { "type": "string", "description": "User's email" },
        "passwordHash": { "type": "string", "description": "Hashed password" },
        "salt": { "type": "string", "description": "Salt for password hash" },
        "username": { "type": "string", "description": "Unique username handle" }
      },
      "required": ["id", "name", "email", "passwordHash", "salt", "username"]
    },
    "Message": {
      "title": "Message",
      "description": "Realtime direct message between users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "senderName": { "type": "string", "description": "Sender user's display name" },
        "receiverId": { "type": "string", "description": "Receiver user's ID" },
        "text": { "type": "string", "description": "Message content" },
        "timestamp": { "type": "string", "description": "Formatted date string of message creation" }
      },
      "required": ["id", "senderName", "receiverId", "text", "timestamp"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Conversation between users or in a group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique conversation ID" },
        "name": { "type": "string", "description": "Name of group conversation" },
        "avatarUrl": { "type": "string", "description": "Group conversation avatar URL" },
        "createdTime": { "type": "number", "description": "Timestamp when the conversation was created" },
        "isGroup": { "type": "boolean", "description": "Whether the conversation is a group chat" },
        "participants": { "type": "array", "description": "User IDs participating in the conversation" }
      },
      "required": ["id", "createdTime", "isGroup", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique chat message ID" },
        "senderId": { "type": "string", "description": "Sender user ID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderAvatar": { "type": "string", "description": "Sender avatar URL" },
        "text": { "type": "string", "description": "Message content" },
        "timestamp": { "type": "number", "description": "Creation timestamp" },
        "conversationId": { "type": "string", "description": "ID of parent conversation" },
        "status": { "type": "string", "description": "Message delivery status" },
        "readBy": { "type": "array", "description": "User IDs who have read this message" }
      },
      "required": ["id", "senderId", "senderName", "text", "timestamp", "conversationId"]
    },
    "SearchQuery": {
      "title": "SearchQuery",
      "description": "A search log submitted by a real user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique query log ID" },
        "term": { "type": "string", "description": "Search term entered" },
        "userId": { "type": "string", "description": "ID of searching user" },
        "countryCode": { "type": "string", "description": "Country of searching user" },
        "timestamp": { "type": "number", "description": "Timestamp when query was run" }
      },
      "required": ["id", "term", "userId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of all user accounts and profiles"
    },
    "/searchQueries/{searchQueryId}": {
      "schema": { "$ref": "#/entities/SearchQuery" },
      "description": "Collection of all live real search queries"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Collection of all direct messages"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Collection of all conversations"
    },
    "/chatMessages/{chatMessageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Collection of all individual chat messages"
    }
  }
}
