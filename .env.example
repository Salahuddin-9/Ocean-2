[TEMPLATE]
# ── Ocean — Environment variables ──────────────────────────────────────────
# Empty ⇒ that feature degrades gracefully / stays off.
# Copy to `.env` and fill in real values for production.

# ── Runtime mode ───────────────────────────────────────────────────────────
# Set NODE_ENV=production to enable fail-closed secret validation. Without it
# the server refuses to start when JWT_SECRET / TELEGRAM_BOT_TOKEN are missing.
NODE_ENV=development

# ── CORS / security headers ────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API. The Express server
# also serves the Vite client on :3000 (same-origin, CORS not needed there);
# add the standalone Vite dev origin (default :5173) and any deployed origins.
# server.ts also applies helmet() security headers (CSP, X-Frame-Options, ...).
CORS_ORIGIN=http://localhost:5173

# ── Audio / Video calling ──────────────────────────────────────────────────
# Jitsi Meet host used by group meetings & the "Meet" tab.
# 8x8.vc (open public Jitsi, embeddable on mobile) is the built-in default;
# the component auto-falls back to meet.jit.si if its script can't load.
# Point at a self-hosted Jitsi server (deployable from jitsi-meet-master)
# for privacy / production.
VITE_JITSI_HOST=8x8.vc

# TURN server for keyless P2P WebRTC calls (chat 1:1 + random "Meet" calls).
# REQUIRED for calls to work across strict NATs / firewalls (the built-in
# public STUN servers only help when at least one peer is reachable).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ── Optional: Stream Video SDK (skips keyless fallback) ────────────────────
STREAM_API_KEY=
STREAM_SECRET_KEY=

# ── Auth / security ────────────────────────────────────────────────────────
# REQUIRED in production. The server FAILS CLOSED when unset: no mock secrets
# are seeded, and the process exits at startup (validateStartupEnvironment).
JWT_SECRET=
# Admin gate for /api/admin/* + 2FA encrypted backups. When unset the legacy
# development fallback is used and a loud warning is printed — set this.
MASTER_KEY=

# ── Firebase / Firestore sync ──────────────────────────────────────────────
# REQUIRED for cloud sync in production. Can be the raw service-account JSON
# or a path to the service-account .json file. The server uses the Admin SDK
# (bypasses firestore.rules); without it, sync degrades to local database.json.
SERVICE_ROLE_KEY=

# ── Optional integrations (degrade gracefully when unset) ──────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
TELEGRAM_BOT_TOKEN=
REDIS_URL=
SUPABASE_URL=
APP_URL=
